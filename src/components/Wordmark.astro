---
// Text wordmark with a small waypoint mark (same as the favicon) until there is a logo.
// "Family" in the heading serif, "Wayfinder" in clay.
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={["wordmark", { inverse }]}>
  <svg class="mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <circle class="dot" cx="13" cy="51" r="5" />
    <circle class="dot" cx="23" cy="43" r="5" />
    <circle class="dot" cx="33" cy="38" r="5" />
    <path class="pin" d="M44 42 C 44 42, 30 28, 30 20 A 14 14 0 0 1 58 20 C 58 28, 44 42, 44 42 Z" />
    <circle class="hole" cx="44" cy="20" r="5" />
  </svg>
  <span class="text"><span class="family">Family</span> <span class="wayfinder">Wayfinder</span></span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }
  .mark { width: 1.6em; height: 1.6em; flex: none; }
  .dot { fill: var(--harbour); }
  .pin { fill: var(--clay); }
  .hole { fill: var(--surface, #fff); }
  .family { color: var(--harbour-deep); }
  .wayfinder { color: var(--clay); font-weight: 700; }
  .inverse .family { color: var(--paper); }
  .inverse .wayfinder { color: var(--peach); }
  .inverse .dot { fill: var(--paper); }
  .inverse .pin { fill: var(--peach); }
  .inverse .hole { fill: var(--harbour-deep); }
  @media (max-width: 22rem) {
    .wordmark { font-size: 1.3rem; }
  }
</style>
